PROXY_TESTER_HTTP_ADDR=0.0.0.0:8080
PROXY_TESTER_GRPC_ADDR=0.0.0.0:50051
PROXY_TESTER_STATIC_DIR=/opt/proxy-tester/frontend/dist
PROXY_TESTER_ARTIFACT_DIR=/var/lib/proxy-tester/artifacts
PROXY_TESTER_RETENTION_DAYS=90
PROXY_TESTER_AGENT_GRACE_SECS=10
PROXY_TESTER_COMMAND_TIMEOUT_SECS=10
DATABASE_URL=sqlite:///var/lib/proxy-tester/proxy-tester.db?mode=rwc
RUST_LOG=proxy_control=info
