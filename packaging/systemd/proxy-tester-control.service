[Unit]
Description=Proxy Tester control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=proxy-tester
Group=proxy-tester
EnvironmentFile=/etc/proxy-tester/control.env
ExecStart=/usr/local/bin/proxy-control
Restart=always
RestartSec=2
NoNewPrivileges=true
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
