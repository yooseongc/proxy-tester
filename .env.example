# Control UI/API port on the Docker host
PROXY_TESTER_PORT=18080
# External gRPC port used by agents on other hosts
PROXY_TESTER_GRPC_PORT=50051
# Pin release images in production, for example ghcr.io/ORG/proxy-tester-control:0.1.0
PROXY_TESTER_CONTROL_IMAGE=proxy-tester-control:local
PROXY_TESTER_AGENT_IMAGE=proxy-tester-agent:local
