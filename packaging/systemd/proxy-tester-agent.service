[Unit]
Description=Proxy Tester traffic agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/proxy-tester/agent.env
ExecStart=/usr/bin/proxy-agent
Restart=always
RestartSec=2
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN
ReadWritePaths=/var/lib/proxy-tester -/run/netns
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
